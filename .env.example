# Skopiuj jako .env  (plik .env NIE trafia do repozytorium – jest w .gitignore).
# Tu są tylko NAZWY zmiennych. Wartości produkcyjne trzymamy w sekretach GitHuba
# (środowisko "production"), a kopię w menedżerze haseł.
# Komentarze tylko w osobnych liniach – nie za wartością.

# ===== Aplikacja =====
# development / test / production
APP_ENV=development

# Lokalnie adres bazy ustawia docker-compose.yml. Gdy uruchamiasz uvicorn bez Dockera, odkomentuj:
# DATABASE_URL=postgresql+psycopg://skaner:skaner@localhost:5432/skaner

# Losowy ciąg, w produkcji wymagany (min. 32 znaki). Wygeneruj:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Pierwsze konto administratora – tworzone tylko, gdy baza jest pusta. PIN: 4–12 cyfr.
ADMIN_NAME=Admin
ADMIN_PIN=1234

# Token, którym Cloud Scheduler wywołuje ponawianie wysyłek do Fakturowni (w produkcji min. 32 znaki)
SYNC_TOKEN=

TIMEZONE=Europe/Warsaw
# text lokalnie, json w chmurze (Google Cloud Logging)
LOG_FORMAT=text
LOG_LEVEL=INFO

# ===== Fakturownia – lokalnie TYLKO konto testowe =====
# false = nic nie jest wysyłane do Fakturowni
FAKTUROWNIA_ENABLED=false
# np. mojafirma-test  ->  mojafirma-test.fakturownia.pl
FAKTUROWNIA_DOMAIN=
# Ustawienia -> Ustawienia konta -> Integracja -> Kod autoryzacyjny API
FAKTUROWNIA_TOKEN=
# ID magazynów: W drodze / Główny / Reklamacje
WAREHOUSE_TRANSIT_ID=
WAREHOUSE_MAIN_ID=
WAREHOUSE_RETURNS_ID=
FAKTUROWNIA_DEPARTMENT_ID=
FAKTUROWNIA_DEFAULT_SUPPLIER=Zakupy w sklepach stacjonarnych
